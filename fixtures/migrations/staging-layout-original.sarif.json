{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Layout demo",
          "version": "1.0"
        }
      },
      "invocations": [
        {
          "executableLocation": {
            "uri": "echo"
          },
          "arguments": [
            "Synthetic fixture; no verification performed"
          ],
          "workingDirectory": {
            "uri": "./"
          },
          "executionSuccessful": true,
          "exitCode": 0,
          "startTimeUtc": "2026-09-10T10:00:00.000Z",
          "endTimeUtc": "2026-09-10T10:00:00.000Z",
          "environmentVariables": {},
          "stdout": {
            "index": 0
          }
        }
      ],
      "versionControlProvenance": [
        {
          "repositoryUri": "https://github.com/proofs-rs/proofs-rs",
          "revisionId": "0000000000000000000000000000000000000000"
        }
