      "properties": {
        "proofs": {
          "platform": "Synthetic platform",
          "rustc": "Synthetic compiler",
          "contracts": [
            {
              "harness": "demo",
              "api_paths": [
                "report_layout_demo::decode"
              ],
              "properties": [
                "panic_contract",
                "no_ub"
