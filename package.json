{
  "name": "proofs-rs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:demo": "node --import tsx scripts/demo.ts",
    "demo:reset": "node --import tsx scripts/demo.ts reset",
    "test:demo": "node --import tsx --test tests/demo.test.ts",
    "build": "vite build && npm run build:book",
    "build:book": "node scripts/build-book.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy:staging": "node scripts/provision.mjs && wrangler d1 migrations apply DB --remote --config wrangler.staging.json && wrangler deploy --config wrangler.staging.json",
    "build:preview": "node scripts/build-preview.mjs",
    "check:preview": "node scripts/build-preview.mjs --check",
    "test:recording-contract": "node --import tsx --test --test-name-pattern=\"CLI recording contract\" tests/cli-contract.ts && node scripts/check-recording-contract-guards.mjs",
    "test:cli-contract": "npm run check:recording-schema && node --import tsx tests/run-cli-contract.ts",
    "build:recording-schema": "node --import tsx scripts/build-recording-schema.ts",
    "check:recording-schema": "node --import tsx scripts/build-recording-schema.ts --check"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "^0.12.6",
    "hono": "^4.9.0",
    "hono-openapi": "^1.3.3",
    "markdown-it": "^15.0.3",
    "sanitize-html": "^2.18.1",
    "semver": "^7.7.0",
    "workers-og": "^0.0.27",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/semver": "^7.7.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.0.0"
  }
}
