{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proofs-rs-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "APP_ORIGIN": "http://localhost:8787",
    "GITHUB_CLIENT_ID": "",
    "EMAIL_FROM": "",
    "EMAIL_ALLOWLIST": "",
    "ADMIN_GITHUB_IDS": "540144",
    "TERMS_VERSION": "2026-09-21",
    "EMAIL_DISABLED": "true",
    "SHOW_STAR_KARMA": "false",
    "SHOW_HOME_DISCUSSION": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proofs-rs-staging-reports-v1",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "proofs-rs-staging-reports-v1"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "proofs-rs-staging-reports-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "proofs-rs-staging-reports-jobs",
        "max_batch_size": 5,
        "max_retries": 3,
        "dead_letter_queue": "proofs-rs-staging-reports-dead"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *", "17 2 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
